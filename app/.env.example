PORT=8080
BIGPAW_ENV=production
BIGPAW_PUBLIC_BASE_URL=https://bigpaw.jp
BIGPAW_DATA_DIR=/data
BIGPAW_DEV_LINKS=0

# 初回運営者アカウント（本番では必須・パスワード12文字以上）
BIGPAW_ADMIN_EMAIL=info@bigpaw.jp
BIGPAW_ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD

# 予約金。初期運用は手動確認。外部決済Webhookを使う場合はproviderへ変更しsecretを設定。
BIGPAW_PAYMENT_MODE=manual
BIGPAW_PAYMENT_WEBHOOK_SECRET=

# BIG PAW 成約手数料
BIGPAW_COMMISSION_RATE_BPS=500
BIGPAW_COMMISSION_DUE_DAYS=7
BIGPAW_COMMISSION_TERMS_VERSION=2026-09-16-v1

# 請求書発行者情報（公開前に実データへ変更）
BIGPAW_BILLING_ISSUER_NAME=茂呂義之
BIGPAW_BILLING_POSTAL=331-0064
BIGPAW_BILLING_ADDRESS=埼玉県さいたま市西区佐知川1294-2
BIGPAW_BILLING_INVOICE_REG_NO=
BIGPAW_BILLING_BANK_NAME=
BIGPAW_BILLING_BANK_BRANCH=
BIGPAW_BILLING_BANK_ACCOUNT_TYPE=普通
BIGPAW_BILLING_BANK_ACCOUNT_NO=
BIGPAW_BILLING_BANK_ACCOUNT_HOLDER=

# メール配信
BIGPAW_SMTP_HOST=
BIGPAW_SMTP_PORT=587
BIGPAW_SMTP_USER=noreply@bigpaw.jp
BIGPAW_SMTP_PASSWORD=
BIGPAW_SMTP_FROM=noreply@bigpaw.jp
BIGPAW_SMTP_TLS=1

# 自動運用
BIGPAW_AUTOMATION_INTERVAL_SECONDS=300
BIGPAW_AUTO_BACKUP_HOURS=24
BIGPAW_AUTO_BACKUP_KEEP=14
BIGPAW_MAX_UPLOAD_BYTES=8388608
