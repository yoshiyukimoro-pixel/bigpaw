FROM python:3.13-slim
WORKDIR /app
COPY app/ /app/
RUN ["python3", "-c", "from pathlib import Path; p=Path('/app/backend/server.py'); s=p.read_text(encoding='utf-8'); a=\"if path=='/api/puppies':\\n            u=self.require(['buyer','breeder','operator']);\"; b=\"if path=='/api/puppies':\\n            u=self.require(['breeder','operator']);\"; c=\"m=re.fullmatch(r'/api/puppies/([^/]+)',path)\\n        if m:\\n            u=self.require(['buyer','breeder','operator']);\"; d=\"m=re.fullmatch(r'/api/puppies/([^/]+)',path)\\n        if m:\\n            u=self.require(['breeder','operator']);\"; assert s.count(a)==1, ('create_guard_count',s.count(a)); assert s.count(c)==1, ('edit_guard_count',s.count(c)); s=s.replace(a,b,1).replace(c,d,1); mkr=\"    init_db(); threading.Thread(target=automation_monitor_loop,daemon=True,name='automation-monitor').start(); os.chdir(ROOT); port=int(os.environ.get('PORT','8080'))\"; rep=\"    init_db()\\n    try:\\n        _od=db(); _orows=_od.execute(\\\"SELECT p.id,p.name,p.created_at,p.status,COALESCE(p.breeder_name,''),(SELECT COUNT(*) FROM inquiries i WHERE i.puppy_id=p.id),(SELECT COUNT(*) FROM deals d WHERE d.puppy_id=p.id) FROM puppies p WHERE p.breeder_id IS NULL AND p.review_status='pending' ORDER BY p.created_at\\\").fetchall(); print('ORPHAN_PENDING_DIAG|'+json.dumps([tuple(r) for r in _orows],ensure_ascii=False),flush=True); print('ORPHAN_PENDING_COUNT|'+str(len(_orows)),flush=True); _od.close()\\n    except Exception as _oe:\\n        print('ORPHAN_PENDING_DIAG_ERROR|'+type(_oe).__name__+':'+str(_oe),flush=True)\\n    threading.Thread(target=automation_monitor_loop,daemon=True,name='automation-monitor').start(); os.chdir(ROOT); port=int(os.environ.get('PORT','8080'))\"; assert s.count(mkr)==1, ('startup_marker_count',s.count(mkr)); s=s.replace(mkr,rep,1); p.write_text(s,encoding='utf-8'); print('PUPPY_PERMISSION_GUARD_OK|create=breeder_operator|edit=breeder_operator',flush=True)"]
ENV PORT=8080
EXPOSE 8080
CMD ["python3", "backend/server.py"]
